# Generate a URL-safe PostgreSQL password before running Compose.
# Create client API keys in /account after operator setup; no server API key is needed.
POSTGRES_PASSWORD=

# Generate once with openssl rand -hex 32. Keep a separate, secure backup.
MORSEL_SHARE_LINK_KEY=

MORSEL_ENVIRONMENT=development
MORSEL_URL=http://localhost:12647/
MORSEL_PORT=12647
