{
  "name": "@narumitw/morsel",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @narumitw/morsel-viewer",
    "ci": "biome ci . && npm run test:deploy && npm run test:release && npm run changeset -- status && npm run ci --workspaces",
    "changeset": "node scripts/changeset.mjs",
    "release": "node scripts/release.mjs",
    "release:version": "node scripts/changeset.mjs version",
    "test:release": "node --test scripts/test-release.mjs",
    "test:deploy": "node --test scripts/test-deploy.mjs",
    "test": "vitest run",
    "test:browser": "npm run test:browser --workspace @narumitw/morsel-viewer",
    "test:auth:browser": "node scripts/test-auth-browser.mjs",
    "prepare": "husky"
  },
  "overrides": {
    "katex": "0.19.0",
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@changesets/apply-release-plan": "8.1.1",
    "@changesets/assemble-release-plan": "7.0.0",
    "@changesets/changelog-git": "1.0.0",
    "@changesets/config": "4.0.1",
    "@changesets/read": "1.0.1",
    "@changesets/write": "1.0.1",
    "@manypkg/tools": "2.1.2",
    "husky": "^9.1.7",
    "semver": "7.8.5",
    "vitest": "^5.0.5"
  }
}
