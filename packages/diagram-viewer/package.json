{
  "name": "@narumitw/diagram-viewer",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Composable React diagram viewer and framework-independent browser controls",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/morsel.git",
    "directory": "packages/diagram-viewer"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:package": "node test/consumer.mjs",
    "test:browser": "npm run build && playwright test",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:package"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vega-embed": "7.3.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
