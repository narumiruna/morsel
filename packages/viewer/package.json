{
  "name": "@narumitw/morsel-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "predev": "npm run build --workspace @narumitw/diagram-viewer",
    "dev": "vite",
    "prebuild": "npm run build --workspace @narumitw/diagram-viewer",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build --workspace @narumitw/diagram-viewer",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check .",
    "format": "biome format --write .",
    "pretest": "npm run build --workspace @narumitw/diagram-viewer",
    "test": "vitest run",
    "pretest:browser": "npm run build --workspace @narumitw/diagram-viewer",
    "test:browser": "playwright test",
    "openapi:lint": "redocly lint --config ../server/redocly.yaml ../server/openapi.yaml",
    "ci": "npm run openapi:lint && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@narumitw/diagram-viewer": "0.2.0",
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/themes": "3.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "dompurify": "3.4.18",
    "katex": "0.19.1",
    "mermaid": "^12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-expression": "6.2.2",
    "vega-lite": "6.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@redocly/cli": "2.78.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/dompurify": "3.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
