{
  "name": "@morsel/viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "openapi:lint": "redocly lint --config ../api/redocly.yaml ../api/openapi.yaml",
    "ci": "npm run openapi:lint && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/themes": "3.3.0",
    "dompurify": "3.4.15",
    "katex": "0.18.7",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "vega": "6.4.0",
    "vega-embed": "7.2.0",
    "vega-expression": "6.2.2",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.53.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/dompurify": "3.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
